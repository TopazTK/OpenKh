<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
             xmlns:model="using:OpenKh.Tools.ModManager.Models"
             xmlns:vm="using:OpenKh.Tools.ModManager.ViewModels"
             xmlns:view="clr-namespace:OpenKh.Tools.ModManager.Views"
             x:Class="OpenKh.Tools.ModManager.Views.ModListView">

        <ListBox Name="MainList" Background="Transparent" ItemsSource="{ReflectionBinding InstalledMods}" SelectedItem="{ReflectionBinding CurrentMod}">
        <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type model:ModModel}">
                <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="{ReflectionBinding ModActive}"/>
                    <Border Margin="5" VerticalAlignment="Center" CornerRadius="5" ClipToBounds="true">
                        <Image Width="64" Height="64" Source="{ReflectionBinding ModIcon}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <Label Content="{ReflectionBinding ModTitle}" FontWeight="Bold"/>
                        <Label Content="{ReflectionBinding ModAuthor}"/>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</ContentPage>
