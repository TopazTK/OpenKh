<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="115"
        MaxWidth="350" MaxHeight="115"
        MinWidth="350" MinHeight="115"
        x:Class="OpenKh.Tools.ModManager.Dialogs.InvalidYamlError"
        Title="Not a Valid Mod!">
    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="This is not a valid (or compliant) OpenKH Mod. Please make sure the mod exists and is valid." TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="OK" Click="AcceptDialog" HorizontalContentAlignment="Center" Width="50" HotKey="Enter"/>
        </StackPanel>
    </StackPanel>
</Window>
