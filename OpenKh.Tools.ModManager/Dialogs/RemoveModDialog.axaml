<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="100"
        MaxWidth="350" MaxHeight="100"
        MinWidth="350" MinHeight="100"
        x:Class="OpenKh.Tools.ModManager.Dialogs.RemoveModDialog"
        Title="Remove Selected Mod?">
    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="Selected mod will be deleted! Are you sure?" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Yes" Click="AcceptDialog" HorizontalContentAlignment="Center" Width="50" HotKey="Enter"/>
            <Button Content="No" Click="RejectDialog" HorizontalContentAlignment="Center" Width="50" HotKey="Escape"/>
        </StackPanel>
    </StackPanel>
</Window>
