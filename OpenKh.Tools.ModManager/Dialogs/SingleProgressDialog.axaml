<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" SizeToContent="Height" MaxWidth="350" CanResize="False"
        x:Class="OpenKh.Tools.ModManager.Dialogs.SingleProgressDialog"
        xmlns:model="using:OpenKh.Tools.ModManager.Models"
        xmlns:view="clr-namespace:OpenKh.Tools.ModManager.Views"
        Title="Installing Mod..." WindowStartupLocation="CenterOwner">
    <StackPanel Margin="15" Spacing="5">
        <TextBlock Text="Installing Mod... Please be patient..." TextWrapping="Wrap" />
        <ProgressBar Name="InstallProgress" Height="20" Maximum="1" Value="0" ShowProgressText="True" FontSize="12" ProgressTextFormat="Receiving Git Objects: {0} / {3}"/>
        <Button Margin="0, 10, 0, 0" Content="Cancel" Click="OnCancelEvent" HorizontalAlignment="Right" HorizontalContentAlignment="Right"/>
    </StackPanel>
</Window>
