<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" SizeToContent="WidthAndHeight" MinWidth="350"
        x:Class="OpenKh.Tools.ModManager.Dialogs.BuildProgressDialog"
        xmlns:model="using:OpenKh.Tools.ModManager.Models"
        xmlns:view="clr-namespace:OpenKh.Tools.ModManager.Views"
        Title="Building Mods..." WindowStartupLocation="CenterOwner">
    <StackPanel Margin="15" Spacing="5">
        <TextBlock Text="Building mods... Please be patient..." TextWrapping="Wrap" />
        <ProgressBar Name="ModProgress" Height="20" Maximum="1" Value="0" ShowProgressText="True" FontSize="12" ProgressTextFormat=""/>
        <ProgressBar Name="AssetProgress" Height="20" Maximum="1" Value="0" ShowProgressText="True" FontSize="12" ProgressTextFormat="Processing Files: {0} / {3}"/>
        <Button Content="Cancel" Click="OnCancelEvent" Margin="0, 10, 0, 0" HorizontalAlignment ="Right" HorizontalContentAlignment="Right"/>
    </StackPanel>
</Window>
